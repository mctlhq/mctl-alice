# mctl-alice configuration. Two modes:
#
# 1. Hosted / multi-user (AUTH_REQUIRED=true): each user signs in with Yandex ID
#    and their credentials are stored encrypted in the database.
# 2. Single-user / legacy (AUTH_REQUIRED unset): one Yandex account from the
#    variables at the bottom, for a local or self-hosted instance.

# --- Hosted / multi-user mode ---------------------------------------------
# AUTH_REQUIRED=true
# PUBLIC_BASE_URL=https://alice.example.com   # exact origin browsers use
# PORT=8080

# Yandex OAuth app (https://oauth.yandex.ru), scopes iot:view and iot:control
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# YANDEX_CALLBACK_URL=https://alice.example.com/auth/callback

# Storage: PostgreSQL when DATABASE_URL is set, SQLite files otherwise
# DATABASE_URL=postgresql://user:password@host:5432/mctl-alice
# OAUTH_DB_PATH=./data/oauth.db
# TELEMETRY_DB_PATH=./data/telemetry.db

# Encryption of stored Yandex credentials: 32 bytes as 64 hex or 44 base64
# characters (openssl rand -base64 32). See README "Rotating the encryption key".
# ENCRYPTION_KEY=
# ENCRYPTION_KEYS=k1:<key>,k2:<key>
# ENCRYPTION_KEY_ID=k2
# REENCRYPT_STORED_CREDENTIALS=true   # one-shot, during a key rotation
# REHASH_STORED_SECRETS=true          # one-shot, after upgrading from < 2.2.3

# Client address for rate limits behind a proxy that overwrites the header
# (only behind a proxy you control). Cloudflare: cf-connecting-ip
# CLIENT_IP_HEADER=cf-connecting-ip
# TRUST_PROXY_HOPS=0

# Prometheus metrics on a separate, unauthenticated listener (all interfaces);
# unset = no metrics. Keep this port off the public network.
# METRICS_PORT=9464

# --- Single-user / legacy mode --------------------------------------------
# Yandex OAuth token with iot:view and iot:control
YANDEX_OAUTH_TOKEN=y0_AgAAAA...
# YANDEX_REFRESH_TOKEN=
# Optional Quasar session cookie for TTS and text commands (unofficial API)
# YANDEX_COOKIE=

# Optional: default speaker id or name when there are several
# DEFAULT_SPEAKER="Гостиная"

# Telemetry sampling (single-user mode only)
# TELEMETRY_SAMPLING_ENABLED=true
# TELEMETRY_SAMPLE_INTERVAL_MS=60000
# TELEMETRY_RETENTION_DAYS=30
