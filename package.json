{
  "name": "mctl-alice",
  "version": "2.6.0",
  "description": "Model Context Protocol (MCP) server for controlling Yandex Alice smart speakers via Yandex Cloud IoT API",
  "type": "module",
  "bin": {
    "mctl-alice": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/auth/cli.ts",
    "start": "node dist/index.js",
    "restore-check": "node dist/restore-check.js",
    "start:http": "PORT=8080 node dist/index.js",
    "test": "vitest run",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "check:tokens": "node scripts/sync-tokens.mjs --check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yandex",
    "alice",
    "smart-home",
    "station",
    "ai-assistant"
  ],
  "author": "mctlhq",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
